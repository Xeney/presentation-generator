# Копия: cp .env.example .env
# Файл .env не коммитится (см. .gitignore): ключи остаются только на вашей машине.

# --- Провайдер LLM ---
# ollama        — открытые веса, локальный инференс (эталон для сдачи по ТЗ);
# aitunnel      — OpenAI-совместимый шлюз с моделями Qwen (ADR-020);
# openai_compat — любой другой OpenAI-совместимый шлюз (ADR-019).
# Ключи живут только в .env: файл в .gitignore, в репозиторий не попадает.
LLM_PROVIDER=aitunnel
# VLM-аудит: aitunnel | openai_compat | ollama | off (пусто = как у LLM)
VLM_PROVIDER=aitunnel

# --- AITUNNEL: OpenAI-совместимый API, модели Qwen с открытыми весами ---
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1
AITUNNEL_API_KEY=
AITUNNEL_LLM_MODEL=qwen3.5-9b
AITUNNEL_VLM_MODEL=qwen3.5-9b
AITUNNEL_TIMEOUT_SEC=120
AITUNNEL_MAX_RETRIES=1
# Qwen3.5 по умолчанию «размышляет» и иногда упирается в таймаут;
# для JSON-ответов thinking выключен (быстрее и стабильнее)
AITUNNEL_DISABLE_THINKING=true
# DEMO_MODE=true — без тихого отката: если модель недоступна, задание падает
# с понятной ошибкой, а не собирается офлайн-планировщиком
DEMO_MODE=false

# --- Произвольный OpenAI-совместимый шлюз (пример: https://opencode.ai/zen/v1) ---
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_VLM_MODEL=
OPENAI_COMPAT_EMBEDDING_MODEL=

# --- LLM (Ollama) ---
# В Docker Compose адрес http://ollama:11434 подставляется автоматически.
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct
LLM_MODEL_14B=qwen2.5:14b-instruct
VLM_MODEL=qwen2.5-vl:7b-instruct
EMBEDDING_MODEL=bge-m3
DISABLE_LLM=false

# --- Pipeline ---
MAX_SLIDES=15
MIN_SLIDES=4
TARGET_DURATION_MIN=5
# VLM-аудит дорогой по времени: по умолчанию только для одного варианта вёрстки
VLM_AUDIT_ENABLED=true
VLM_AUDIT_ALL_VARIANTS=false

# --- Grounding: опора на контент-пакет (числа точно, смысл через BGE-M3) ---
GROUNDING_ENABLED=true
GROUNDING_OFF_SOURCE_THRESHOLD=0.55
GROUNDING_DUPLICATE_THRESHOLD=0.92

# --- Хранилище / экспорт ---
DATA_DIR=./data
MAX_UPLOAD_MB=60
LIBREOFFICE_BIN=soffice

# --- API ---
CORS_ORIGINS=http://localhost:3000
JOB_CLEANUP_HOURS=12.0
