# Копия: cp .env.example .env
# --- LLM (Ollama) ---
# В Docker Compose адрес http://ollama:11434 подставляется автоматически.
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct
LLM_MODEL_14B=qwen2.5:14b-instruct
VLM_MODEL=qwen2.5-vl:7b-instruct
EMBEDDING_MODEL=bge-m3
DISABLE_LLM=false

# --- Pipeline ---
MAX_SLIDES=15
MIN_SLIDES=4
TARGET_DURATION_MIN=5

# --- Хранилище / экспорт ---
DATA_DIR=./data
MAX_UPLOAD_MB=60
LIBREOFFICE_BIN=soffice

# --- API ---
CORS_ORIGINS=http://localhost:3000
JOB_CLEANUP_HOURS=12.0