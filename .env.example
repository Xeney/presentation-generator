# Копия: cp .env.example .env
# Файл .env не коммитится (см. .gitignore): ключи остаются только на вашей машине.

# --- Провайдер LLM ---
# ollama        — по умолчанию: открытые веса, локальный инференс (требование ТЗ);
# openai_compat — внешний OpenAI-совместимый шлюз, ТОЛЬКО для разработки,
#                 когда под рукой нет GPU/Ollama (ADR-019). В сдаче не используется.
LLM_PROVIDER=ollama
# Пример внешнего шлюза (OpenCode Zen): https://opencode.ai/zen/v1
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_VLM_MODEL=
OPENAI_COMPAT_EMBEDDING_MODEL=

# --- LLM (Ollama) ---
# В Docker Compose адрес http://ollama:11434 подставляется автоматически.
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct
LLM_MODEL_14B=qwen2.5:14b-instruct
VLM_MODEL=qwen2.5-vl:7b-instruct
EMBEDDING_MODEL=bge-m3
DISABLE_LLM=false

# --- Pipeline ---
MAX_SLIDES=15
MIN_SLIDES=4
TARGET_DURATION_MIN=5
# VLM-аудит дорогой по времени: по умолчанию только для одного варианта вёрстки
VLM_AUDIT_ENABLED=true
VLM_AUDIT_ALL_VARIANTS=false

# --- Grounding: опора на контент-пакет (числа точно, смысл через BGE-M3) ---
GROUNDING_ENABLED=true
GROUNDING_OFF_SOURCE_THRESHOLD=0.55
GROUNDING_DUPLICATE_THRESHOLD=0.92

# --- Хранилище / экспорт ---
DATA_DIR=./data
MAX_UPLOAD_MB=60
LIBREOFFICE_BIN=soffice

# --- API ---
CORS_ORIGINS=http://localhost:3000
JOB_CLEANUP_HOURS=12.0
